+    /// Resolve a `pane.copy_mode_jump` request into the absolute text point a client should place
+    /// its copy-mode cursor on. The client push itself happens in the headless server.
+    pub(crate) fn handle_pane_copy_mode_jump(
+        &mut self,
+        id: String,
+        params: PaneCopyModeJumpParams,
+    ) -> String {
+        let Some((ws_idx, pane_id)) = self.parse_pane_id(&params.pane_id) else {
+            return pane_not_found(id, &params.pane_id);
+        };
+        let Some(runtime) =
+            self.state
+                .runtime_for_pane_in_workspace(&self.terminal_runtimes, ws_idx, pane_id)
+        else {
+            return pane_not_found(id, &params.pane_id);
+        };
+        let revision = runtime.content_seq();
+        let width = runtime
+            .terminal_dimensions()
+            .map_or(1, |(cols, _)| cols.max(1));
+        // A live pane keeps churning (prompt repaints, agent output) while the user picks. The
+        // target row's own text is the identity that matters: when it still holds what the caller
+        // captured, the cell is still the cell the user meant.
+        let row_text = |runtime: &crate::terminal::TerminalRuntime| {
+            let selection = crate::selection::Selection::absolute_range(
+                pane_id,
+                (params.viewport_row + viewport_top(&runtime), 0),
+                (params.viewport_row + viewport_top(&runtime), width.saturating_sub(1)),
+            );
+            runtime.extract_selection(&selection)
+        };
+        let row_unchanged = params
+            .expected_row
+            .as_deref()
+            .zip(row_text(&runtime))
+            .is_some_and(|(expected, current)| expected.trim_end() == current.trim_end());
+        if params
+            .content_revision
+            .is_some_and(|content_revision| content_revision != revision)
+            && !row_unchanged
+        {
+            return encode_error(id, "stale_content", "pane content changed");
+        }
+        let Some(metrics) = runtime.scroll_metrics() else {
+            return encode_error(
+                id,
+                "copy_mode_jump_unavailable",
+                "pane scroll metrics are unavailable",
+            );
+        };
+        if !row_unchanged
+            && params.offset_from_bottom.is_some_and(|offset| {
+                offset != u64::try_from(metrics.offset_from_bottom).unwrap_or(u64::MAX)
+            })
+        {
+            return encode_error(id, "stale_pane_viewport", "pane viewport changed");
+        }
+        let viewport_rows = u32::try_from(metrics.viewport_rows).unwrap_or(u32::MAX);
+        if params.viewport_row >= viewport_rows {
+            return encode_error(
+                id,
+                "invalid_viewport_row",
+                "viewport row is outside the pane",
+            );
+        }
+        if params.viewport_col >= width {
+            return encode_error(
+                id,
+                "invalid_viewport_col",
+                "viewport column is outside the pane",
+            );
+        }
+        let row = viewport_top(&runtime).saturating_add(params.viewport_row);
+        encode_success(
+            id,
+            ResponseResult::PaneCopyModeJump {
+                pane_id: params.pane_id,
+                cursor: crate::api::schema::PaneTextPoint {
+                    row,
+                    col: params.viewport_col,
+                },
+                content_revision: revision,
+            },
+        )
+    }
