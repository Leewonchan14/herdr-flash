+    /// Command configured to run from this literal key inside copy mode.
+    fn copy_mode_command(
+        &self,
+        ch: char,
+    ) -> Option<(String, crate::protocol::ClientShellCommandAction)> {
+        let snapshot = self.snapshot.as_deref()?;
+        snapshot
+            .commands
+            .iter()
+            .find(|command| command.copy_mode_key == Some(ch))
+            .map(|command| (command.command_id.clone(), command.action))
+    }
+
+    /// Enter copy mode on an explicit text point, as requested by `pane.copy_mode_jump`.
+    ///
+    /// The jump only applies to the pane this client is showing; anything else is ignored so a
+    /// stray jump can never move the cursor in a pane the user is not looking at.
+    pub(crate) fn enter_copy_mode_at(
+        &mut self,
+        pane_id: &str,
+        cursor: crate::api::schema::PaneTextPoint,
+    ) -> bool {
+        if self.focused_pane_id().as_deref() != Some(pane_id) {
+            return false;
+        }
+        if self.popup_terminal_id.is_some() || self.popup_pending {
+            // The popup owns the mode while it is open and resets it when it closes, so remember
+            // the target and apply it then.
+            self.pending_copy_jump = Some((pane_id.to_owned(), cursor));
+            return true;
+        }
+        self.apply_copy_mode_at(pane_id, cursor)
+    }
+
+    /// Apply a jump that arrived while a popup was open. Returns true when one was applied.
+    pub(crate) fn apply_pending_copy_jump(&mut self) -> bool {
+        if self.popup_terminal_id.is_some() || self.popup_pending {
+            return false;
+        }
+        let Some((pane_id, cursor)) = self.pending_copy_jump.take() else {
+            return false;
+        };
+        self.apply_copy_mode_at(&pane_id, cursor)
+    }
+
+    fn apply_copy_mode_at(
+        &mut self,
+        pane_id: &str,
+        cursor: crate::api::schema::PaneTextPoint,
+    ) -> bool {
+        if self.focused_pane_id().as_deref() != Some(pane_id) {
+            return false;
+        }
+        if self
+            .copy_mode
+            .as_ref()
+            .is_some_and(|copy_mode| copy_mode.pane_id == pane_id)
+        {
+            if let Some(copy_mode) = self.copy_mode.as_mut() {
+                copy_mode.cursor = cursor;
+                copy_mode.selection = None;
+            }
+            self.selection = None;
+            self.mode = ClientShellMode::Copy;
+            return true;
+        }
+        let Some(hit) = self
+            .hits
+            .panes
+            .iter()
+            .find(|hit| hit.pane_id == pane_id)
+            .cloned()
+        else {
+            return false;
+        };
+        let Some(metrics) = hit.scroll else {
+            return false;
+        };
+        let (content_revision, alternate_screen_active) = self
+            .pane_surface
+            .as_ref()
+            .and_then(|surface| surface.panes.iter().find(|pane| pane.pane_id == pane_id))
+            .map_or((0, false), |pane| {
+                (pane.content_revision, pane.alternate_screen_active)
+            });
+        self.selection = None;
