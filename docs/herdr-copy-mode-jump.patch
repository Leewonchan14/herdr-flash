+/// Absolute row of the pane's first visible row.
+fn viewport_top(runtime: &crate::terminal::TerminalRuntime) -> u32 {
+    runtime.scroll_metrics().map_or(0, |metrics| {
+        u32::try_from(
+            metrics
+                .max_offset_from_bottom
+                .saturating_sub(metrics.offset_from_bottom),
+        )
+        .unwrap_or(u32::MAX)
+    })
+}
