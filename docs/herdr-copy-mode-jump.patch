+    let raw = raw?.trim();
+    if raw.is_empty() {
+        return None;
+    }
+    let mut chars = raw.chars();
+    let (Some(ch), None) = (chars.next(), chars.next()) else {
+        let diag = format!(
+            "keys.command[{index}].copy_mode_key must be exactly one character; ignoring it"
+        );
+        warn!(message = %diag, "config diagnostic");
+        diagnostics.push(diag);
+        return None;
+    };
+    if action != CustomCommandAction::PluginAction {
+        let diag = format!(
+            "keys.command[{index}].copy_mode_key only applies to plugin actions; ignoring it"
+        );
+        warn!(message = %diag, "config diagnostic");
+        diagnostics.push(diag);
+        return None;
+    }
